# Server Configuration
PORT=5001
NODE_ENV=production

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_change_in_production

# Database Configuration - Local MongoDB (Development)
MONGO_URL=mongodb://localhost:27017/unque
# Alternative variable name:
# MONGODB_URI=mongodb://localhost:27017/unque
# DB_NAME=unque

# AWS DocumentDB Configuration (Production)
# Set USE_DOCUMENTDB=true to enforce DocumentDB TLS and retryWrites=false settings
# USE_DOCUMENTDB=true
# MONGODB_URI=mongodb://docdbadmin:<PASSWORD>@<docdb-cluster-endpoint>:27017/unque?tls=true&retryWrites=false
# MONGO_URL=mongodb://docdbadmin:<PASSWORD>@<docdb-cluster-endpoint>:27017/unque?tls=true&retryWrites=false
# DOCUMENTDB_CA_PATH=./certs/global-bundle.pem
# DOCUMENTDB_DIRECT_CONNECTION=true
