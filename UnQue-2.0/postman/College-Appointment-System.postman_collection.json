  },
  "variable": [
    { "key": "baseUrl", "value": "localhost:5001", "type": "string" },
    { "key": "professorToken", "value": "", "type": "string" },
    { "key": "student1Token", "value": "", "type": "string" },
    { "key": "student2Token", "value": "", "type": "string" },
    { "key": "professorId", "value": "", "type": "string" },
    { "key": "student1Id", "value": "", "type": "string" },
