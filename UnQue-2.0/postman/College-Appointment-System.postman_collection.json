          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function() { pm.response.to.have.status(200); });",
              "var jsonData = pm.response.json();",
              "pm.test('Token received', function() { pm.expect(jsonData.token).to.exist; });",
              "pm.test('Role is student', function() { pm.expect(jsonData.role).to.eql('student'); });",
              "pm.collectionVariables.set('student1Token', jsonData.token);",
              "pm.collectionVariables.set('student1Id', jsonData.id);"
            ]
          }
        }
      ]
    },
