    {
      "name": "10. Student A1 Views Available Slots",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{student1Token}}" }
        ],
        "url": { "raw": "http://{{baseUrl}}/general/professor/{{professorId}}/availability", "protocol": "http", "host": ["{{baseUrl}}"], "path": ["general", "professor", "{{professorId}}", "availability"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function() { pm.response.to.have.status(200); });",
              "var jsonData = pm.response.json();",
              "pm.test('Has available slots', function() { pm.expect(jsonData.availableSlots).to.be.an('array'); });",
              "pm.test('At least 3 slots available', function() { pm.expect(jsonData.availableSlots.length).to.be.at.least(3); });"
            ]
          }
        }
      ]
