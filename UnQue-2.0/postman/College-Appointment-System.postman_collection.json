          "mode": "raw",
          "raw": "{\n  \"email\": \"student1@example.com\",\n  \"password\": \"Test@123\"\n}"
        },
        "url": { "raw": "http://{{baseUrl}}/users/login", "protocol": "http", "host": ["{{baseUrl}}"], "path": ["users", "login"] }
