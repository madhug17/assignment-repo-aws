  "item": [
    {
      "name": "01. Register Student A1",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Student A1\",\n  \"email\": \"student1@example.com\",\n  \"password\": \"Test@123\",\n  \"confirmPassword\": \"Test@123\",\n  \"role\": \"student\"\n}"
        },
        "url": { "raw": "http://{{baseUrl}}/users/register", "protocol": "http", "host": ["{{baseUrl}}"], "path": ["users", "register"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 201', function() { pm.response.to.have.status(201); });",
              "var jsonData = pm.response.json();",
              "pm.test('User created', function() { pm.expect(jsonData.newUser).to.exist; });",
              "pm.collectionVariables.set('student1Id', jsonData.newUser._id);"
            ]
          }
        }
      ]
    },
    {
      "name": "02. Login Student A1",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
